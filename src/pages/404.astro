---
import Base from '../layouts/Base.astro';
---

<Base
  locale="en"
  pageKey="home"
  title="Page Not Found"
  description="This page could not be found. Return to Nguyen Linh Protector or browse the Vietnamese website."
  noindex
>
  <section class="container section error-page">
    <p class="eyebrow blue">404</p>
    <h1>We couldn’t find that page.</h1>
    <p>
      The address may have changed. Start from our homepage or contact our team.
    </p>
    <div class="hero-actions">
      <a class="button" href="/">
        Return to homepage ↗
      </a>
      <a class="text-link" href="/vi/" lang="vi">
        Về trang chủ tiếng Việt ↗
      </a>
      <a class="text-link" href="/contact/">
        Contact our team ↗
      </a>
    </div>
  </section>
</Base>
