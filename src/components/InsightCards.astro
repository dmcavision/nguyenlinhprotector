---
import type { CollectionEntry } from 'astro:content';
import { pairs, type Locale } from '../i18n/routes';
import { copy } from '../i18n/copy';
interface Props {
  locale: Locale;
  articles: CollectionEntry<'insights'>[];
  headingLevel?: 'h2' | 'h3';
}
const { locale, articles, headingLevel: Heading = 'h2' } = Astro.props;
const t = copy[locale];
const en = locale === 'en';
---

<div class="insights-grid">
  {articles.map((entry, i) => (
    <article class="insight-card">
      <div class="article-index">
        <span class="mono">
          {en ? 'FIELD GUIDE' : 'HƯỚNG DẪN'} / 0{i + 1}
        </span>
        <span aria-hidden="true">↗</span>
      </div>
      <p class="eyebrow blue">{t.pages[entry.data.related[0]].title}</p>
      <Heading>
        <a href={pairs[entry.data.translationKey][locale]}>
          {entry.data.title}
        </a>
      </Heading>
      <p>{entry.data.description}</p>
      <a
        class="text-link"
        href={pairs[entry.data.translationKey][locale]}
        aria-label={`${t.read}: ${entry.data.title}`}
      >
        {t.read} <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</div>
