---
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<ol class="process-grid">
  {copy[locale].steps.map(([title, text], i) => (
    <li>
      <span class="step-number">0{i + 1}</span>
      <h3>{title}</h3>
      <p>{text}</p>
    </li>
  ))}
</ol>
